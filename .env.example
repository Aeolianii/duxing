# 在高德控制台创建「Web端（JS API）」Key。
# 将此文件复制为 .env，填入对应值后重启启动原型.cmd。
AMAP_JS_KEY=
AMAP_SECURITY_CODE=

# DeepSeek 密钥仅在本地后端使用，不打包、不提交。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# 授权票务服务的适配接口，留空使用内置铁路查询；航空需要生产凭据
TRAVEL_QUOTE_URL=
TRAVEL_QUOTE_TOKEN=

AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# pip install flights==0.9.0 click 后填写 fli 可执行文件路径
FLI_BIN=
